(footprint "Atlas_EZO_Carrier_Gen2_Mount"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Mount for the Atlas Scientific Electrically Isolated EZO Carrier Board Gen 2: four 3.2 mm NPTH on a 24 x 34 mm rectangle for its #4-40 standoffs; carrier 32 x 42 mm. No pads: the carrier connects by its own 5-wire Dupont cable from its right-angle header (VCC, OFF, GND, TX/SDA, RX/SCL) to a separate 1x05 2.54 mm male header placed beside the carrier's pin edge (+x). Geometry from Atlas's 3D model")
